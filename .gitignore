*.3mf
*.gcode
*.bgcode

# ---- 大文件 ----
*.mp4
*.mov
*.avi

# ---- STM32 资料 ----
*.rar
*.pack
# 厂商例程全集（22 个工程，含重复 HAL 库，约 2.7GB），本地参考不入库
firmware/stm32/examples/
# ---- 本地存档 / 工具链 / 临时产物（体积大，不入库）----
outputs/
_本地存档_不入库/
_工具链/
_tmp_extract/
/_*.txt
/_*.py
# ---- 参考资料（体积大或含第三方版权，不入库）----
# STM32 手册 / 数据手册 / 厂商文档：本地查阅即可
firmware/stm32/docs/
firmware/stm32/datasheets/
hardware/datasheets/
hardware/electrical/datasheets/
*.pdf
*.PDF

# ---- 临时草稿 / 调试输出（编辑过程残留）----
# 形如 _q10.txt / _sec01.txt / _pb.txt 的片段文件不应入库
_*.txt
_*.log

